// Acrescente este bloco dentro de match /databases/{database}/documents.
match /metasAtendimento/{metaId} {
  function metaValida(data) {
    return data.keys().hasAll(['professorUid','alunoId','fonte','descricao','criterio','referencia','ativa','createdAt','updatedAt'])
      && data.keys().hasOnly(['professorUid','alunoId','fonte','descricao','criterio','referencia','ativa','createdAt','updatedAt'])
      && data.professorUid == request.auth.uid
      && data.alunoId is string
      && get(/databases/$(database)/documents/alunos/$(data.alunoId)).data.professorUid == request.auth.uid
      && data.fonte in ['PAEE','PEI']
      && data.descricao is string && data.descricao.size() > 0 && data.descricao.size() <= 1000
      && data.criterio is string && data.criterio.size() <= 500
      && data.referencia is string && data.referencia.size() <= 200
      && data.ativa is bool
      && data.createdAt is timestamp && data.updatedAt == request.time;
  }
  allow read: if request.auth != null && resource.data.professorUid == request.auth.uid;
  allow create: if request.auth != null && metaValida(request.resource.data)
    && request.resource.data.createdAt == request.time;
  allow update: if request.auth != null && resource.data.professorUid == request.auth.uid
    && metaValida(request.resource.data)
    && request.resource.data.professorUid == resource.data.professorUid
    && request.resource.data.alunoId == resource.data.alunoId
    && request.resource.data.createdAt == resource.data.createdAt;
  allow delete: if false;
}
