rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Copie somente este bloco match para dentro das regras existentes.
    match /planosAula/{autorUid}/{planoId}/{arquivo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == autorUid
        && arquivo.matches('[a-zA-Z0-9-]+[.]docx')
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
      // Cada substituição cria um arquivo novo. Não permite reescrever um arquivo publicado.
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == autorUid;
    }
  }
}
