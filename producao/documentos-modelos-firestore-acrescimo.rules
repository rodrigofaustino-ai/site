    // Acrescentar DENTRO de match /databases/{database}/documents, sem remover regras existentes.
    match /documentosModelos/{modeloId} {
      function gerenciaModelo() {
        return request.auth != null && (resource.data.autorUid == request.auth.uid ||
          (request.auth.uid == 'xF20nknLCsZxk0giHFso8NqV8KH3' && request.auth.token.email == 'rodrigofaustino@gmail.com'));
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && modeloId.matches('[a-f0-9-]{36}')
        && request.resource.data.keys().hasOnly(['titulo','descricao','formato','nomeArquivo','tamanho','tipo','caminho','autorUid','autorNome','ativo','criadoEm'])
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 120
        && request.resource.data.descricao is string && request.resource.data.descricao.size() <= 1000
        && request.resource.data.nomeArquivo is string && request.resource.data.nomeArquivo.size() > 0 && request.resource.data.nomeArquivo.size() <= 180
        && request.resource.data.autorNome is string && request.resource.data.autorNome.size() > 0 && request.resource.data.autorNome.size() <= 120
        && request.resource.data.tamanho is int && request.resource.data.tamanho > 0 && request.resource.data.tamanho <= 10485760
        && ((request.resource.data.formato == 'docx' && request.resource.data.tipo == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
            (request.resource.data.formato == 'pdf' && request.resource.data.tipo == 'application/pdf'))
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.caminho == 'documentosModelos/' + request.auth.uid + '/' + modeloId + '/arquivo'
        && request.resource.data.ativo == true && request.resource.data.criadoEm == request.time;
      allow update: if gerenciaModelo() && resource.data.ativo == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo']) && request.resource.data.ativo == false;
      allow delete: if gerenciaModelo() && resource.data.ativo == false;
    }
