rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'A1Zn1xCUUvVM1YkqCtnULzPblI43';
    }
    match /paee_alunos/{id} {
      allow read, delete: if request.auth != null && (resource.data.professorUid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (request.auth != null && resource.data.professorUid == request.auth.uid
        && request.resource.data.professorUid == resource.data.professorUid);
      allow create: if request.auth != null && request.resource.data.professorUid == request.auth.uid;
    }
    match /relatorios_srm/{id} {
      allow read, delete: if request.auth != null && (resource.data.professorUid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (request.auth != null && resource.data.professorUid == request.auth.uid
        && request.resource.data.professorUid == resource.data.professorUid);
      allow create: if request.auth != null && request.resource.data.professorUid == request.auth.uid;
    }
    match /diagnostica_srm/{id} {
      allow read, delete: if request.auth != null && (resource.data.professorUid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (request.auth != null && resource.data.professorUid == request.auth.uid
        && request.resource.data.professorUid == resource.data.professorUid);
      allow create: if request.auth != null && request.resource.data.professorUid == request.auth.uid;
    }
  }
}
