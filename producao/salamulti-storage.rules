rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /planosAula/{autorUid}/{planoId}/{arquivo} {
      // Usuários logados podem consultar e baixar os planos.
      allow read: if request.auth != null;
      // Somente o autor pode enviar arquivos neste caminho.
      allow create: if request.auth != null
        && request.auth.uid == autorUid
        && arquivo.matches('[a-zA-Z0-9-]+[.]docx')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType
          == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
      // A substituição cria um novo arquivo pelo site.
      allow update: if false;
      // Somente o autor pode excluir o arquivo.
      allow delete: if request.auth != null && request.auth.uid == autorUid;
    }

    match /chatAnexos/{autorUid}/{mensagemId}/arquivo {
      function dono() { return request.auth != null && request.auth.uid == autorUid; }
      function publicado() {
        let path = /databases/(default)/documents/chatEquipe/$(mensagemId);
        let m = firestore.get(path).data;
        let a = m.get('anexo', {});
        return m.autorUid == autorUid && m.get('apagada', false) != true
          && a.get('caminho','') == 'chatAnexos/' + autorUid + '/' + mensagemId + '/arquivo'
          && a.get('tipo','') == resource.contentType
          && a.get('tamanho',0) == resource.size
          && a.get('nome','') == resource.metadata.get('nomeOriginal','');
      }
      // O autor pode conferir seu upload privado antes de publicar a mensagem.
      // Depois da publicação, só mensagens disponíveis autorizam a leitura pela equipe.
      allow get: if request.auth != null &&
        ((dono() && !firestore.exists(/databases/(default)/documents/chatEquipe/$(mensagemId))) || publicado());
      allow list: if false;
      allow create: if dono()
        && !firestore.exists(/databases/(default)/documents/chatEquipe/$(mensagemId))
        && request.resource.size > 0 && request.resource.size <= 10485760
        && request.resource.contentType in ["image/jpeg", "image/png", "image/gif", "image/webp", "application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.oasis.opendocument.text", "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/vnd.oasis.opendocument.spreadsheet", "application/vnd.ms-powerpoint", "application/vnd.openxmlformats-officedocument.presentationml.presentation", "application/vnd.oasis.opendocument.presentation", "text/plain", "text/csv", "application/zip"]
        && request.resource.metadata.get('nomeOriginal','') is string
        && request.resource.metadata.get('nomeOriginal','').size() > 0
        && request.resource.metadata.get('nomeOriginal','').size() <= 180;
      allow update: if false;
      allow delete: if dono();
    }

    // Os demais caminhos continuam bloqueados.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
