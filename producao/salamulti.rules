match /respostasFamiliaCompletas/{token} {
  allow read: if request.auth != null && resource.data.professorUid == request.auth.uid;
  allow create: if familiaLinkAtivo(token)
    && get(/databases/$(database)/documents/convitesFamilia/$(token)).data.versao == 2
    && request.resource.data.keys().hasAll(['professorUid','alunoId','versao','responsavel','vinculo','contexto','observacoes','ciencia','enviadoEm','envioId'])
    && request.resource.data.keys().hasOnly(['professorUid','alunoId','versao','responsavel','vinculo','contexto','observacoes','ciencia','enviadoEm','envioId'])
    && request.resource.data.professorUid == get(/databases/$(database)/documents/convitesFamilia/$(token)).data.professorUid
    && request.resource.data.alunoId == get(/databases/$(database)/documents/convitesFamilia/$(token)).data.alunoId
    && request.resource.data.versao == 2 && request.resource.data.ciencia == true
    && request.resource.data.envioId is string && request.resource.data.envioId.matches('[a-f0-9]{32}')
    && request.resource.data.envioId == getAfter(/databases/$(database)/documents/enviosFamilia/$(token)).data.envioId
    && request.resource.data.responsavel is string && request.resource.data.responsavel.size() > 0 && request.resource.data.responsavel.size() <= 120
    && request.resource.data.vinculo is string && request.resource.data.vinculo.size() > 0 && request.resource.data.vinculo.size() <= 80
    && request.resource.data.contexto is string && request.resource.data.contexto.size() <= 2000
    && request.resource.data.observacoes is string && request.resource.data.observacoes.size() <= 2000
    && request.resource.data.enviadoEm == request.time
    && getAfter(/databases/$(database)/documents/enviosFamilia/$(token)).data.enviadoEm == request.time
    && familiaAreasCompletas(token);
  allow update, delete: if false;
  match /areas/{area} {
    allow read: if request.auth != null && get(/databases/$(database)/documents/respostasFamiliaCompletas/$(token)).data.professorUid == request.auth.uid;
    allow create: if familiaLinkAtivo(token)
      && request.resource.data.keys().hasAll(['respostas','observacoesPerguntas','enviadoEm'])
      && request.resource.data.keys().hasOnly(['respostas','observacoesPerguntas','enviadoEm'])
      && request.resource.data.enviadoEm == request.time
      && getAfter(/databases/$(database)/documents/respostasFamiliaCompletas/$(token)).data.enviadoEm == request.time
      && getAfter(/databases/$(database)/documents/enviosFamilia/$(token)).data.enviadoEm == request.time
      && ((area == 'oralidade' && familiaArea_oralidade(request.resource.data))
        || (area == 'leitura' && familiaArea_leitura(request.resource.data))
        || (area == 'escrita' && familiaArea_escrita(request.resource.data))
        || (area == 'percepcao' && familiaArea_percepcao(request.resource.data))
        || (area == 'avd' && familiaArea_avd(request.resource.data))
        || (area == 'social' && familiaArea_social(request.resource.data))
        || (area == 'numeros' && familiaArea_numeros(request.resource.data))
        || (area == 'medidas' && familiaArea_medidas(request.resource.data))
        || (area == 'rotina' && familiaArea_rotina(request.resource.data)));
    allow update, delete: if false;
  }
}

  }
}